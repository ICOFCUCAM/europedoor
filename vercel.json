{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "site",
  "buildCommand": "python3 tools/build.py",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/atlas",
      "destination": "/countries",
      "permanent": true
    },
    {
      "source": "/atlas/:macro",
      "destination": "/discover/:macro",
      "permanent": true
    },
    {
      "source": "/atlas/:macro/:country",
      "destination": "/europe/:country",
      "permanent": true
    },
    {
      "source": "/atlas/:macro/:country/:region",
      "destination": "/europe/:country/:region",
      "permanent": true
    },
    {
      "source": "/atlas/:macro/:country/:region/:city",
      "destination": "/europe/:country/:region/:city",
      "permanent": true
    },
    {
      "source": "/business",
      "destination": "/for-businesses",
      "permanent": true
    },
    {
      "source": "/experiences/:kind(walk|table|workshop|water|museum|sacred|ride|stage|wild|cellar)",
      "destination": "/experiences/kind/:kind",
      "permanent": true
    }
  ]
}
